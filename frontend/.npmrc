# @vitejs/plugin-react 6 optionally peers @rolldown/plugin-babel, which drags in
# @babel/plugin-transform-runtime 8 and its @babel/core ^8 peer, conflicting with
# the 7.x already in the tree. npm cannot resolve that chain on its own.
#
# Setting this here rather than passing --legacy-peer-deps by hand keeps `npm i`,
# `npm ci` and the Dockerfile build using one resolution mode. Without it `npm ci`
# rejects the lock file that `npm install` just produced.
#
# Revisit once the upstream babel/rolldown peer ranges line up.
legacy-peer-deps=true
